cabal-version:      2.4
name:               qlearning-hs
version:            0.1.0.0
synopsis:           Q-Learning tabular em Haskell (trabalho em grupo)
build-type:         Simple
extra-doc-files:    README.md

common comum
    default-language: Haskell2010
    ghc-options:      -Wall

library
    import:           comum
    hs-source-dirs:   src
    exposed-modules:  Rng
    build-depends:    base >=4 && <5
                    , containers

executable qlearning-demo
    import:           comum
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >=4 && <5
                    , qlearning-hs
